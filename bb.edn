;; clojure-shadcn — bb tasks
;;
;; Dev workflow:
;;   bb dev           — stories watcher + Storybook dev server
;;   bb watch-stories — shadow-cljs stories watcher only
;;   bb build-storybook — static site into storybook-static/

{:tasks
 {generate-story-modules
  {:doc "Generate shadow-cljs ESM module config from CLJS story sources"
   :task (shell "bb scripts/generate_story_modules.clj")}

  generate-story-bridges
  {:doc "Generate Storybook CSF bridges from compiled ESM story modules"
   :task (shell "clojure -M:cljs-dev -e \"(require 'clojure-shadcn.stories.helpers.bridge-gen) (clojure-shadcn.stories.helpers.bridge-gen/generate-all!)\"")}

  prepare-stories
  {:doc "Generate config, compile stories, and create bridges before Storybook indexes them"
   :depends [generate-story-modules]
   :task (do (shell "npx shadow-cljs compile stories --config-merge target/story-modules.edn")
             (run 'generate-story-bridges))}

  dev
  {:doc "Full dev environment: prepare stories, then start watcher + Storybook"
   :depends [prepare-stories]
   :task (let [futures [(future (shell "npx shadow-cljs watch stories --config-merge target/story-modules.edn"))
                        (future (shell "npx storybook dev -p 6010"))]]
           (doseq [f futures] (deref f)))}

  watch-stories
  {:doc "Watch and compile CLJS stories only"
   :depends [generate-story-modules]
   :task (shell "npx shadow-cljs watch stories --config-merge target/story-modules.edn")}

  compile-stories
  {:doc "One-shot compile of CLJS stories and ESM bridge generation"
   :depends [generate-story-modules]
   :task (do (shell "npx shadow-cljs compile stories --config-merge target/story-modules.edn")
             (run 'generate-story-bridges))}

  storybook
  {:doc "Prepare stories, then run Storybook dev server on port 6010"
   :depends [prepare-stories]
   :task (shell "npx storybook dev -p 6010")}

  build-storybook
  {:doc "Build static Storybook site into storybook-static/"
   :depends [prepare-stories]
   :task (shell "npx storybook build")}

  clean
  {:doc "Remove build artifacts"
   :task (shell "rm -rf .shadow-cljs cljs-stories stories/js storybook-static target/story-modules.edn")}}}
